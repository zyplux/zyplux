{
  "name": "zyplux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "knip": "knip",
    "format": "prettier --write --cache --log-level warn .",
    "typecheck": "tsc -b",
    "lint": "eslint . --cache",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run",
    "cz": "node apps/cz/src/index.ts",
    "lint:mermaid": "pnpm run --silent cz lint-mermaid",
    "release:prepare": "uv run airlock prepare && pnpm run --filter @zyplux/eslint-config dump-rules",
    "release:check": "uv run airlock check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@zyplux/eslint-config": "workspace:*",
    "@zyplux/spectra": "workspace:*",
    "@zyplux/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
