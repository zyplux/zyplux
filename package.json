{
  "name": "zyplux",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "knip": "knip",
    "format": "pnpm run format:prettier && pnpm run format:md && pnpm run format:py",
    "format:prettier": "prettier --write --cache --log-level warn .",
    "format:md": "uv run rumdl fmt",
    "format:py": "uv run ruff format",
    "typecheck": "pnpm run typecheck:ts && uv run pyrefly check",
    "typecheck:ts": "tsc -b",
    "lint": "pnpm run lint:workflows && pnpm run lint:ts && pnpm run lint:md && pnpm run lint:py",
    "lint:ts": "pnpm run lint:eslint --fix && pnpm run format:prettier",
    "lint:md": "pnpm run lint:mermaid && uv run rumdl check --fix --no-cache && pnpm run format:md",
    "lint:py": "uv run ruff check --fix && pnpm run format:py",
    "lint:eslint": "eslint . --cache",
    "test": "vitest run",
    "cz": "node apps/cz/src/index.ts",
    "lint:mermaid": "pnpm run --silent cz lint-mermaid",
    "release:prepare": "uv run airlock prepare",
    "skills:refresh": "skills experimental_install",
    "prepare": "test ! -e .git || lefthook install",
    "lint:workflows": "actionlint -shellcheck 'uv run --no-sync shellcheck' -pyflakes 'uv run --no-sync pyflakes'"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@zyplux/eslint-config": "workspace:*",
    "@zyplux/spectra": "workspace:*",
    "@zyplux/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "skills": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@kjanat/actionlint": "catalog:"
  }
}
