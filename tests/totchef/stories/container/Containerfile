FROM ghcr.io/astral-sh/uv:python3.14-trixie-slim

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends sudo curl unzip ca-certificates libatomic1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home tester \
 && echo 'tester ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/tester \
 && chmod 0440 /etc/sudoers.d/tester

# pnpm on the system PATH; the [pnpm] cook resolves it via find_binary and must drive its
# globals into the user's ~/.local/share/pnpm, not an inherited data dir (§4.3.3). The
# standalone build is a self-contained ELF (no Node needed) and links against libatomic.
ARG PNPM_VERSION=12.0.0-rc.8
RUN mkdir -p /opt/pnpm \
 && curl -fsSL "https://github.com/pnpm/pnpm/releases/download/v${PNPM_VERSION}/pnpm-linux-x64.tar.gz" \
    | tar -xz -C /opt/pnpm \
 && ln -s /opt/pnpm/pnpm /usr/local/bin/pnpm

WORKDIR /src

# uv --locked validates every workspace member's manifest, including unselected packages.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=apps/totchef/pyproject.toml,target=apps/totchef/pyproject.toml \
    --mount=type=bind,source=apps/airlock/pyproject.toml,target=apps/airlock/pyproject.toml \
    --mount=type=bind,source=apps/cerberus/pyproject.toml,target=apps/cerberus/pyproject.toml \
    --mount=type=bind,source=apps/clipy/pyproject.toml,target=apps/clipy/pyproject.toml \
    --mount=type=bind,source=apps/action-setup-pm/pyproject.toml,target=apps/action-setup-pm/pyproject.toml \
    --mount=type=bind,source=apps/token_stats/pyproject.toml,target=apps/token_stats/pyproject.toml \
    --mount=type=bind,source=packages/util_py/pyproject.toml,target=packages/util_py/pyproject.toml \
    uv sync --locked --no-install-project --package totchef

COPY pyproject.toml uv.lock ./
COPY apps/totchef ./apps/totchef
COPY apps/airlock/pyproject.toml ./apps/airlock/pyproject.toml
COPY apps/cerberus/pyproject.toml ./apps/cerberus/pyproject.toml
COPY apps/clipy/pyproject.toml ./apps/clipy/pyproject.toml
COPY apps/action-setup-pm/pyproject.toml ./apps/action-setup-pm/pyproject.toml
COPY apps/token_stats/pyproject.toml ./apps/token_stats/pyproject.toml
COPY packages/util_py/pyproject.toml ./packages/util_py/pyproject.toml
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --package totchef

RUN ln -s /src/.venv/bin/totchef /usr/local/bin/totchef

ENV PATH="/src/.venv/bin:$PATH"

USER tester
WORKDIR /home/tester
