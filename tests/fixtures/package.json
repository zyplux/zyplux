{
  "name": "@zyplux/tests-fixtures",
  "version": "0.5.2",
  "description": "Story-test fixtures for zyplux workspaces: Node exec fake, console capture, fetch routing, temp dirs, domain matchers, and vitest test.extend bases per app type",
  "keywords": [
    "test",
    "fixtures",
    "mock",
    "shell",
    "vitest"
  ],
  "license": "MIT",
  "author": "Sergiy Yeskov <sergiy.yeskov@gmail.com>",
  "homepage": "https://github.com/zyplux/zyplux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyplux/zyplux.git",
    "directory": "tests/fixtures"
  },
  "type": "module",
  "exports": {
    "./cli": "./src/cli.ts",
    "./console": "./src/console.ts",
    "./fetch": "./src/fetch.ts",
    "./fs": "./src/fs.ts",
    "./matchers": "./src/matchers.ts",
    "./package.json": "./package.json",
    "./prompt": "./src/prompt.ts",
    "./shell": "./src/shell.ts",
    "./story": "./src/story.ts"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "./console": {
        "types": "./dist/console.d.ts",
        "default": "./dist/console.js"
      },
      "./fetch": {
        "types": "./dist/fetch.d.ts",
        "default": "./dist/fetch.js"
      },
      "./fs": {
        "types": "./dist/fs.d.ts",
        "default": "./dist/fs.js"
      },
      "./matchers": {
        "types": "./dist/matchers.d.ts",
        "default": "./dist/matchers.js"
      },
      "./package.json": "./package.json",
      "./prompt": {
        "types": "./dist/prompt.d.ts",
        "default": "./dist/prompt.js"
      },
      "./shell": {
        "types": "./dist/shell.d.ts",
        "default": "./dist/shell.js"
      },
      "./story": {
        "types": "./dist/story.d.ts",
        "default": "./dist/story.js"
      }
    }
  },
  "scripts": {
    "prepack": "node --eval \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -b --force tsconfig.json"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zyplux/tsconfig": "workspace:*",
    "vitest": "catalog:"
  }
}
