{
  "name": "@zyplux/eslint-config",
  "version": "0.8.3",
  "description": "Shared ESLint flat config and custom rules",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "flat-config",
    "typescript"
  ],
  "license": "MIT",
  "author": "Sergiy Yeskov <sergiy.yeskov@gmail.com>",
  "homepage": "https://github.com/zyplux/zyplux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyplux/zyplux.git",
    "directory": "packages/eslint-config"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#contracts": "./src/contracts.ts",
    "#create-rule": "./src/create-rule.ts",
    "#plugin": "./src/plugin.ts"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "imports": {
      "#contracts": "./dist/src/contracts.js",
      "#create-rule": "./dist/src/create-rule.js",
      "#plugin": "./dist/src/plugin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./contracts": {
        "types": "./dist/src/contracts.d.ts",
        "default": "./dist/src/contracts.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dump-rules": "node scripts/dump-rules.ts",
    "prepack": "node --eval \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -b --force tsconfig.json"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@typescript-eslint/type-utils": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "@zyplux/util": "workspace:*",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-prefer-arrow-functions": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "typescript-eslint": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zyplux/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
}
