{
  "name": "@zyplux/spectra",
  "version": "0.2.0",
  "description": "Shared Vitest fixtures, matchers, polling, and journal reporting.",
  "keywords": [
    "test",
    "fixtures",
    "mock",
    "shell",
    "vitest"
  ],
  "license": "MIT",
  "author": "Sergiy Yeskov <sergiy.yeskov@gmail.com>",
  "homepage": "https://github.com/zyplux/zyplux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyplux/zyplux.git",
    "directory": "packages/spectra"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./reporters": "./src/reporters/journald-reporter.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./reporters": {
        "types": "./dist/reporters/journald-reporter.d.ts",
        "default": "./dist/reporters/journald-reporter.js"
      },
      "./package.json": "./package.json"
    },
    "imports": {
      "#pattern-match": "./dist/helpers/pattern-match.js",
      "#require-mocked-module": "./dist/helpers/require-mocked-module.js"
    }
  },
  "scripts": {
    "prepack": "node --eval \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -b --force tsconfig.json && publint --pack pnpm --strict"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zyplux/tsconfig": "workspace:*",
    "publint": "catalog:",
    "vitest": "catalog:"
  },
  "imports": {
    "#pattern-match": "./src/helpers/pattern-match.ts",
    "#require-mocked-module": "./src/helpers/require-mocked-module.ts"
  }
}
