{
  "name": "@zyplux/util",
  "version": "0.6.2",
  "description": "Small utilities: assertions, polling, bounded-concurrency mapping, zod-validated JSON reads, repo-URL normalization, package.json/pyproject manifest schemas, and a git/gh shell harness",
  "keywords": [
    "utilities",
    "zod",
    "json",
    "shell",
    "concurrency",
    "manifest"
  ],
  "license": "MIT",
  "author": "Sergiy Yeskov <sergiy.yeskov@gmail.com>",
  "homepage": "https://github.com/zyplux/zyplux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyplux/zyplux.git",
    "directory": "packages/util-ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./exec": "./src/exec.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./contracts": {
        "types": "./dist/contracts.d.ts",
        "default": "./dist/contracts.js"
      },
      "./exec": {
        "types": "./dist/exec.d.ts",
        "default": "./dist/exec.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "prepack": "node --eval \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -b --force tsconfig.json"
  },
  "dependencies": {
    "smol-toml": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zyplux/tsconfig": "workspace:*",
    "zod": "catalog:"
  }
}
