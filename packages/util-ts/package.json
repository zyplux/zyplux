{
  "name": "@zyplux/util",
  "version": "0.7.0",
  "description": "Small utilities: assertions, polling, bounded-concurrency mapping, zod-validated JSON reads, repo-URL normalization, package.json/pyproject manifest schemas, and a git/gh shell harness",
  "keywords": [
    "utilities",
    "zod",
    "json",
    "shell",
    "concurrency",
    "manifest"
  ],
  "license": "MIT",
  "author": "Sergiy Yeskov <sergiy.yeskov@gmail.com>",
  "homepage": "https://github.com/zyplux/zyplux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyplux/zyplux.git",
    "directory": "packages/util-ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts",
    "./exec": "./src/exec.ts",
    "./package.json": "./package.json",
    "./lap-timer": "./src/lap-timer.ts",
    "./module-references": "./src/module-references.ts",
    "./type-dependencies": "./src/type-dependencies.ts"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./contracts": {
        "types": "./dist/contracts.d.ts",
        "default": "./dist/contracts.js"
      },
      "./exec": {
        "types": "./dist/exec.d.ts",
        "default": "./dist/exec.js"
      },
      "./package.json": "./package.json",
      "./lap-timer": {
        "types": "./dist/lap-timer.d.ts",
        "default": "./dist/lap-timer.js"
      },
      "./module-references": {
        "types": "./dist/module-references.d.ts",
        "default": "./dist/module-references.js"
      },
      "./type-dependencies": {
        "types": "./dist/type-dependencies.d.ts",
        "default": "./dist/type-dependencies.js"
      }
    }
  },
  "scripts": {
    "prepack": "node --eval \"require('node:fs').rmSync('dist', { force: true, recursive: true })\" && tsc -b --force tsconfig.json"
  },
  "dependencies": {
    "smol-toml": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@zyplux/tsconfig": "workspace:*",
    "zod": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
